# Shared device configuration for firmware, Flask, and Android.
# Edit this file when you provision a different MCU or change shared endpoints.

# Identity and access
SWT_DEVICE_ID=swt-000-000-000-001
SWT_DEVICE_API_KEY=SwtLocalDevice001Key2026!
SWT_OTA_HOSTNAME=SmartWaterTank01
SWT_OTA_PASSWORD=SwtOtaLocal001!
SWT_LOCAL_WEB_AUTH_USERNAME=swtadmin
SWT_LOCAL_WEB_AUTH_PASSWORD=swtadmin@1234
SWT_FORCE_BUILD_WEB_AUTH_PASS=1
SWT_FORCE_BUILD_DEVICE_ID=0

# Local device URL and static network
SWT_LOCAL_DEVICE_URL=http://192.168.1.50/
SWT_WIFI_GATEWAY=192.168.1.1
SWT_WIFI_SUBNET=255.255.255.0
SWT_WIFI_DNS=8.8.8.8
SWT_LOCAL_FLASK_BASE_URL=http://192.168.1.2:8000/
SWT_CLOUD_BASE_URL=https://salewell.co.in/
SWT_FLASK_CHANNEL_MODE=cloud

# Flask backend active source mode: use real for MCU data, virtual for scripts/virtual_device.py
SWT_DEVICE_SOURCE_MODE=real
