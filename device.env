# MySQL
DB_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=salewellco_swtadmin
MYSQL_PASSWORD=Tiger@1234
MYSQL_DATABASE=salewellco_swtadmin

# Keep this value permanent across every deployment.
# Generate a long random value; do not use supersecret123.
APP_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Low-resource hosting configuration
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_READ_TIMEOUT_SECONDS=10
MYSQL_WRITE_TIMEOUT_SECONDS=10

BACKGROUND_DB_MAX_WORKERS=1
DASHBOARD_SUMMARY_RECONCILIATION_ENABLED=false
DASHBOARD_SUMMARY_MIN_REFRESH_SECONDS=300
ANALYTICS_SYNC_EVENTS_ON_REQUEST=false

DB_MAINTENANCE_ENABLED=false
DB_PRUNE_MIN_INTERVAL_SECONDS=3600
DB_RETENTION_DELETE_BATCH_ROWS=500
DB_RETENTION_DELETE_MAX_BATCHES=1
TEMP_HARD_DB_CAP_ENABLED=false

# Email
CUSTOMER_COMMUNICATION_FROM_EMAIL=support@salewell.co.in
