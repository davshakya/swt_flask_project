# Copy this file to device.env and update the values for the MCU you are flashing.
# Firmware, Flask, and Android all read these shared device settings.
# Flask accepts all swt-* devices through SWT_DEVICE_KEYS below.
# SWT_DEVICE_KEYS references SWT_DEVICE_API_KEY so the shared key is defined once.

DEVICE_AUTH_REQUIRED=1
SWT_LOCAL_WEB_AUTH_USERNAME=swtadmin
SWT_LOCAL_WEB_AUTH_PASSWORD=lOpbDRMeXBokNcQ4Y7lfgWDzPretehDY
SWT_CLOUD_BASE_URL=https://salewell.co.in/

# Home Automation board identity. Keep these aligned with ../home_automation_firmware/device.env.

# Shared Android and firmware build versions.

# Flask backend active source mode: use real for MCU data, virtual for scripts/virtual_device.py
SWT_DEVICE_SOURCE_MODE=real
SWT_FTP_PASSWORD=Youandi21#

# Flask database
DB_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=salewellco_swtadmin
MYSQL_PASSWORD=Tiger@1234
MYSQL_DATABASE=salewellco_swtadmin
APP_SECRET_KEY=supersecret123


CUSTOMER_COMMUNICATION_FROM_EMAIL=support@salewell.co.in
CUSTOMER_COMMUNICATION_FROM_NAME=Smart Water Tank Support
SMTP_HOST=mail.salewell.co.in
SMTP_PORT=465
SMTP_USERNAME=support@salewell.co.in
SMTP_PASSWORD=Tiger@1234
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
SALES_ENQUIRY_TO_EMAILS=support@salewell.co.in
SALES_ENQUIRY_BACKUP_PATH=data/sales_enquiries.jsonl

SWT_ANDROID_VERSION_CODE=452
