# Starting profile; merge into cPanel Python app environment variables.
# Keep existing credentials, device keys, and feature rollout settings.
SWT_HOSTING_PROFILE=cpanel
MYSQL_AUTO_CREATE_DATABASE=false
FEATURE_DB_CONNECTION_POOL=true
MYSQL_POOL_SIZE=1
MYSQL_POOL_MAX_OVERFLOW=1
MYSQL_POOL_RECYCLE_SECONDS=60
MYSQL_POOL_WAIT_SECONDS=2
MYSQL_LOCK_WAIT_TIMEOUT_SECONDS=5
SNAPSHOT_CACHE_TTL_SECONDS=2
SNAPSHOT_CACHE_MAX_ENTRIES=128
ANALYTICS_CACHE_TTL_SECONDS=300
DEVICE_CONNECTION_LOG_HEARTBEAT_SECONDS=300
DASHBOARD_SUMMARY_RECONCILIATION_ENABLED=false
DASHBOARD_SUMMARY_MIN_REFRESH_SECONDS=30
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
