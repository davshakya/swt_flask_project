APP_SECRET_KEY=change-me-before-production
# Use /var/data/tank.db on Render or any other persistent disk path in production.
DB_FILE=data/tank.db
LOGIN_USERNAME=admin
LOGIN_PASSWORD=change-me-admin-password
RESET_ADMIN_PASSWORD_ON_BOOT=false
DEFAULT_CUSTOMER_PASSWORD=
SEED_DEFAULT_CUSTOMERS=false
# Device auth now comes from ../device.env by default.
# Set DEVICE_KEYS only if you intentionally need a multi-device override here.
DEVICE_KEYS=
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_WEBHOOK_URL=
RELAY_STATUS_URLS=https://smart-water-tank-v1.onrender.com/status
RELAY_COMMAND_URLS=https://smart-water-tank-v1.onrender.com/device/command
RELAY_VERIFY_TLS=true
MQTT_ENABLED=false
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=swt
MQTT_KEEPALIVE_SEC=30
MQTT_QOS=1
MQTT_COMMAND_RETAIN=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=12
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
DATA_STALE_AFTER_SECONDS=180
DATA_RETENTION_DAYS=45
DB_MAINTENANCE_ENABLED=true
DB_TARGET_SIZE_MB=256
DB_MAINTENANCE_MIN_INTERVAL_SECONDS=900
DB_WAL_AUTOCHECKPOINT_PAGES=1000
TEMP_DB_SIZE_GUARD_ENABLED=false
TEMP_HARD_DB_CAP_ENABLED=false
TEMP_HARD_DB_CAP_BATCH_ROWS=2000
TEMP_HARD_DB_CAP_MAX_BATCHES=24
