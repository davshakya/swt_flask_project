# Copy this file to tests/virtual_devices/device-002.env, device-003.env, etc.
# The emulator runs one device per .env file found in tests/virtual_devices/.

SWT_VIRTUAL_DEVICE_BASE_URL=http://127.0.0.1:8000/
SWT_VIRTUAL_DEVICE_ID=swt-000-000-000-002
SWT_VIRTUAL_DEVICE_KEY=change-me-device-key-002
SWT_VIRTUAL_DEVICE_SOURCE=virtual
SWT_VIRTUAL_DEVICE_LOCAL_URL=http://192.168.1.51/
SWT_VIRTUAL_DEVICE_FIRMWARE_VERSION=virtual-mcu-1.0.0
SWT_VIRTUAL_DEVICE_TANK_HEIGHT_CM=180.0
SWT_VIRTUAL_DEVICE_TANK_CAPACITY_LITERS=1000.0
SWT_VIRTUAL_DEVICE_START_LEVEL_PERCENT=58.0
SWT_VIRTUAL_DEVICE_START_SOURCE_LEVEL_PERCENT=76.0
SWT_VIRTUAL_DEVICE_AUTO_START_PERCENT=28.0
SWT_VIRTUAL_DEVICE_AUTO_STOP_PERCENT=92.0
SWT_VIRTUAL_DEVICE_SOURCE_MIN_RUN_PERCENT=18.0
SWT_VIRTUAL_DEVICE_USAGE_LITERS_PER_HOUR=34.0
SWT_VIRTUAL_DEVICE_FILL_LITERS_PER_HOUR=180.0
SWT_VIRTUAL_DEVICE_SOURCE_RECOVERY_LITERS_PER_HOUR=18.0
SWT_VIRTUAL_DEVICE_TIME_SCALE=6.0
SWT_VIRTUAL_DEVICE_TELEMETRY_INTERVAL=5.0
SWT_VIRTUAL_DEVICE_COMMAND_POLL_INTERVAL=2.5
SWT_VIRTUAL_DEVICE_LOOP_SLEEP=0.5
SWT_VIRTUAL_DEVICE_RUN_SECONDS=0.0
SWT_VIRTUAL_DEVICE_CONNECTED_SECONDS=120.0
SWT_VIRTUAL_DEVICE_DISCONNECTED_SECONDS=30.0
SWT_VIRTUAL_DEVICE_CHANNEL_MODE=both
SWT_VIRTUAL_DEVICE_SEED=43
SWT_VIRTUAL_DEVICE_ENABLE_SOURCE_TANK=true
SWT_VIRTUAL_DEVICE_REQUIRE_ACTIVE_SOURCE=false
SWT_VIRTUAL_DEVICE_LOG_LEVEL=INFO
