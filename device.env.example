# Copy this file to device.env and update the values for the MCU you are flashing.
# Firmware, Flask, and Android all read these shared device settings.

SWT_DEVICE_ID=swt-000-000-000-001
SWT_DEVICE_API_KEY=change-me-device-key
SWT_DEVICE_KEYS=swt-000-000-000-001:change-me-device-key
SWT_LOCAL_WEB_AUTH_USERNAME=swtadmin
SWT_LOCAL_WEB_AUTH_PASSWORD=change-me-local-password
SWT_LOCAL_DEVICE_URL=http://192.168.1.50/
SWT_LOCAL_FLASK_BASE_URL=http://192.168.1.2:8000/
SWT_CLOUD_BASE_URL=https://salewell.co.in/
SWT_FLASK_CHANNEL_MODE=cloud
# Flask backend active source mode: use real for MCU data, virtual for scripts/virtual_device.py
SWT_DEVICE_SOURCE_MODE=real
