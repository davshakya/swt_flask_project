# Copy this file to device.env and update the values for the MCU you are flashing.
# Firmware, Flask, and Android all read these shared device settings.
# Flask accepts SWT tank devices through SWT_DEVICE_KEYS. Values reference env keys so secrets stay defined once.

SWT_DEVICE_ID=swt-000-000-000-001
SWT_DEVICE_API_KEY=change-me-device-key
# Add exact device rules before the wildcard when test or customer firmware
# uses a device-specific key:
# SWT_TEST_DEVICE_API_KEY=replace-with-the-test-device-key
# SWT_DEVICE_KEYS=swt-test-000-000-002:SWT_TEST_DEVICE_API_KEY,swt-*:SWT_DEVICE_API_KEY
SWT_DEVICE_KEYS=swt-*:SWT_DEVICE_API_KEY
DEVICE_AUTH_REQUIRED=1
AUTO_REGISTER_DEVICE_KEYS=0
AUTO_REGISTER_DEVICE_ID_PREFIXES=swt-
AUTO_REGISTER_DEVICE_KEY_MIN_LENGTH=32
SWT_LOCAL_WEB_AUTH_USERNAME=swtadmin
SWT_LOCAL_WEB_AUTH_PASSWORD=change-me-local-password
SWT_LOCAL_DEVICE_URL=
SWT_WIFI_STATIC_CONFIG=0
SWT_WIFI_GATEWAY=192.168.1.1
SWT_WIFI_SUBNET=255.255.255.0
SWT_WIFI_DNS=192.168.1.1
SWT_LOCAL_FLASK_BASE_URL=http://192.168.1.2:8000/
SWT_CLOUD_BASE_URL=https://salewell.co.in/
SWT_CLOUD_POLL_INTERVAL_SECONDS=30
SWT_CLOUD_COMMAND_POLL_INTERVAL_SECONDS=10
SWT_FLASK_CHANNEL_MODE=cloud


# Customer password-reset email. Flask reads these from this device.env file
# so cPanel environment-variable issues do not block reset emails.
CUSTOMER_COMMUNICATION_FROM_EMAIL=support@salewell.co.in
CUSTOMER_COMMUNICATION_FROM_NAME=SaleWell Smart Tank Support
SMTP_HOST=mail.salewell.co.in
SMTP_PORT=465
SMTP_USERNAME=support@salewell.co.in
SMTP_PASSWORD=replace-with-support-mailbox-password
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
SALES_ENQUIRY_TO_EMAILS=support@salewell.co.in
SALES_ENQUIRY_BACKUP_PATH=data/sales_enquiries.jsonl

# Shared build counters. Generated names use vYY.M.<code> in UTC; increase the
# Android code before every APK release. *_VERSION_NAME_BASE is legacy-only.
SWT_FIRMWARE_VERSION_BASE=1.1.0
# SWT_FIRMWARE_VERSION_CODE_BASE=0
# SWT_FIRMWARE_VERSION_CODE=
SWT_ANDROID_VERSION_NAME_BASE=1.1.0
# SWT_ANDROID_VERSION_CODE_BASE=0
# SWT_ANDROID_VERSION_CODE=

# Flask backend active source mode: use real for MCU data, virtual for scripts/virtual_device.py
SWT_DEVICE_SOURCE_MODE=real

# Flask application and MySQL/MariaDB settings. This same device.env file is
# the only local dotenv-style file loaded by the backend.
APP_SECRET_KEY=change-me-before-production
SWT_HOSTING_PROFILE=cpanel
DB_BACKEND=mysql
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL_CA=
# Optional explicit local socket path supplied by your hosting provider.
# localhost:3306 resets can also recover via a discovered Unix socket.
MYSQL_UNIX_SOCKET=
MYSQL_AUTO_CREATE_DATABASE=false
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_READ_TIMEOUT_SECONDS=20
MYSQL_WRITE_TIMEOUT_SECONDS=20
MYSQL_LOCK_WAIT_TIMEOUT_SECONDS=5
MYSQL_OPTIMIZE_ENABLED=false
LOGIN_USERNAME=admin
LOGIN_PASSWORD=change-me-admin-password
RESET_ADMIN_PASSWORD_ON_BOOT=false
DEFAULT_CUSTOMER_PASSWORD=
SEED_DEFAULT_CUSTOMERS=false
SWT_SHOW_PRICING_LINKS=false

# Optional integrations and relay targets.
DEVICE_KEYS=
ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TEAM_PHONE=918796452878
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_PROVIDER=meta
WHATSAPP_META_GRAPH_VERSION=v24.0
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_CONFIRMATION_TEMPLATE=salewell_demo_confirmation
WHATSAPP_META_TEAM_TEMPLATE=salewell_team_new_enquiry
WHATSAPP_META_TEMPLATE_LANGUAGE=en
RELAY_STATUS_URLS=
RELAY_COMMAND_URLS=
RELAY_VERIFY_TLS=true
MQTT_ENABLED=false
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=swt
MQTT_KEEPALIVE_SEC=30
MQTT_QOS=1
MQTT_COMMAND_RETAIN=true

# Browser sessions and WSGI runtime.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_HOURS=12
WEB_CONCURRENCY=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_ACCESS_LOG_ENABLED=false
LOG_LEVEL=warning
# Keep Gunicorn quiet while retaining operational Flask events such as
# telemetry saves, command delivery, and motor state changes.
APP_LOG_LEVEL=info
BACKGROUND_DB_MAX_WORKERS=1

# Optional RAG/OpenAI integration.
RAG_ENABLED=false
RAG_API_KEY=
RAG_DOCUMENT_PATHS=
PUBLIC_RAG_DOCUMENT_PATHS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_MODEL=gpt-5-mini
RAG_LLM_TIMEOUT_SECONDS=30
PUBLIC_RAG_RATE_LIMIT=12
PUBLIC_RAG_RATE_WINDOW_SECONDS=60
PUBLIC_RAG_MAX_QUESTION_LENGTH=600

# Data freshness and retention.
DATA_STALE_AFTER_SECONDS=300
TELEMETRY_LOCAL_SYNC_DEDUPE_WINDOW_SECONDS=30
DATA_RETENTION_DAYS=45
FEATURE_CRON_RETENTION=false
# cPanel hourly: python3 /home/USER/app/scripts/run_capacity_maintenance.py --max-seconds 240
FEATURE_HOURLY_AGGREGATION=false
FEATURE_DAILY_AGGREGATION=false
FEATURE_ARCHIVAL=false
# cPanel aggregation: use --task hourly each hour and --task daily once per day.
FEATURE_DB_CONNECTION_POOL=false
MYSQL_POOL_SIZE=2
MYSQL_POOL_MAX_OVERFLOW=1
MYSQL_POOL_RECYCLE_SECONDS=240
MYSQL_POOL_WAIT_SECONDS=5
FEATURE_DEVICE_REQUEST_LIMITS=false
DEVICE_SYNC_MAX_PAYLOAD_BYTES=8192
FEATURE_SEQUENCE_DEDUPLICATION=false
FEATURE_REPLAY_PROTECTION=false
FEATURE_DEVICE_RATE_LIMITING=false
DEVICE_SYNC_RATE_PER_SECOND=2
DEVICE_SYNC_RATE_BURST=5
DEVICE_SYNC_RATE_TRACKED_DEVICES=5000
FEATURE_DATABASE_JOB_QUEUE=false
FEATURE_CRON_JOB_PROCESSOR=false
# cPanel every 5 minutes: use run_capacity_maintenance.py --task jobs --max-seconds 240
FEATURE_CAPACITY_METRICS=false
FEATURE_CRON_HEALTH=false
FEATURE_DATABASE_SIZE_ALERTS=false
DATABASE_QUOTA_MB=0
FEATURE_OFFSERVER_BACKUP=false
FEATURE_STAGED_ROLLOUT=false
# Advisory combined-sync rollout cohort. Start with an explicit allowlist.
CAPACITY_ROLLOUT_STAGE=disabled
CAPACITY_ROLLOUT_PERCENTAGE=0
CAPACITY_ROLLOUT_DEVICE_ALLOWLIST=
CAPACITY_ROLLOUT_DEVICE_DENYLIST=
CAPACITY_ROLLOUT_TARGET_FIRMWARE_VERSION=
CAPACITY_ROLLOUT_CONFIGURATION_VERSION=
FEATURE_LEGACY_TELEMETRY_ARCHIVE=false
# Enable only after FEATURE_LEGACY_TANK_DATA_WRITES=false is validated.
LEGACY_TELEMETRY_ARCHIVE_BEFORE_DAYS=30
LEGACY_TELEMETRY_ARCHIVE_BATCH_ROWS=1000
FEATURE_HOSTING_MIGRATION_ASSESSMENT=false
HOST_CPU_PERCENT=
HOST_RAM_PERCENT=
HOST_P95_SYNC_MS=
HOST_API_ERROR_PERCENT=
HOST_THRESHOLD_PERSISTENT_SAMPLES=3
HOST_THRESHOLD_BREACH_SAMPLES=0
HOST_MYSQL_CONNECTION_LIMIT_ERRORS=0
HOST_PASSENGER_RESTARTS_FREQUENT=false
HOST_CRON_UNRELIABLE=false
HOST_LOAD_TEST_500_PASSED=
HOST_THROTTLING_DETECTED=false
HOST_UPTIME_GUARANTEE_REQUIRED=false
DB_MAINTENANCE_ENABLED=true
DB_TARGET_SIZE_MB=256
DB_MAINTENANCE_MIN_INTERVAL_SECONDS=900
DB_WAL_AUTOCHECKPOINT_PAGES=1000
TEMP_DB_SIZE_GUARD_ENABLED=false
TEMP_HARD_DB_CAP_ENABLED=false
TEMP_HARD_DB_CAP_BATCH_ROWS=2000
TEMP_HARD_DB_CAP_MAX_BATCHES=24
